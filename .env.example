# Public URL / Plesk proxy target
NEXT_PUBLIC_SITE_URL=https://simplekitchenprep.com
APP_PORT=8088

# Postgres
POSTGRES_DB=simplekitchen
POSTGRES_USER=simplekitchen
POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql://simplekitchen:change-this-long-random-password@db:5432/simplekitchen

# Stripe - never commit real keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Existing six-week menu behaviour
# Copy the current WooCommerce admin cycle start date here before cutover.
CYCLE_START_DATE=2025-03-15
WEEKLY_ITEM_CAP=200
DELIVERY_SLOT_CAP=75

# Commercial settings
# Delivery is £3 in the current subscription flow. Override if the standard checkout differs.
DELIVERY_FEE=3.00
NEXT_PUBLIC_DELIVERY_FEE=3.00
# Exact current Woo minimum was not exposed publicly; set this to the live Woo value before cutover.
MINIMUM_ORDER_AMOUNT=0.00
NEXT_PUBLIC_MINIMUM_ORDER_AMOUNT=0.00

# Weekly subscription quantities. Price is recurring weekly base price before optional delivery.
SUBSCRIPTION_OPTIONS=5:37.50,6:45.00,7:52.50,10:75.00

# Christmas Giving: rounds to the next £ and SK matches the customer donation.
CHRISTMAS_GIVING_ENABLED=true
GIVING_START=2026-11-01
GIVING_END=2026-12-24

# SMTP for subscription choice links / weekly reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Simple Kitchen <simplekitchenprep@gmail.com>"
CRON_SECRET=

# Optional Woo import source used during migration
WOO_SOURCE_URL=https://simplekitchenprep.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
