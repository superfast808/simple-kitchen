# Public URL / Plesk proxy target
NEXT_PUBLIC_SITE_URL=https://simplekitchenprep.com
APP_PORT=8092

# Postgres
POSTGRES_DB=simplekitchen
POSTGRES_USER=simplekitchen
POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql://simplekitchen:change-this-long-random-password@db:5432/simplekitchen

# Stripe - never commit real keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Existing six-week menu behaviour
# Current migration anchor aligns the imported 23 Sep 2026 menu with Week 2.
# Verify against the legacy cycle plugin before final DNS cutover.
CYCLE_START_DATE=2025-03-15
WEEKLY_ITEM_CAP=200
DELIVERY_SLOT_CAP=75

# Commercial settings
# Live Woo contains £3 and £5.49 delivery products. £3 remains the migration
# default until the shipping-method settings are captured and mapped.
DELIVERY_FEE=3.00
NEXT_PUBLIC_DELIVERY_FEE=3.00
MINIMUM_ORDER_AMOUNT=0.00
NEXT_PUBLIC_MINIMUM_ORDER_AMOUNT=0.00

# Fulfilment rules. DELIVERY_ZONES_JSON accepts postcode prefixes and amounts in pence.
# Leave strict matching off until the live Woo shipping zones have been imported.
DELIVERY_ENABLED=true
COLLECTION_ENABLED=true
DELIVERY_REQUIRE_ZONE_MATCH=false
DELIVERY_ZONES_JSON=[]

# Subscription price tables/cadence come from lib/subscriptionPlans.ts
# Woo product 291 = weekly; Woo product 764 = fortnightly.

# Christmas Giving
CHRISTMAS_GIVING_ENABLED=true
GIVING_START=2026-11-01
GIVING_END=2026-12-24

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Simple Kitchen <simplekitchenprep@gmail.com>"
CRON_SECRET=

# Temporary read-only Woo migration credentials
WOO_SOURCE_URL=https://simplekitchenprep.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=


# Weekly non-order SMS reminders (ClickSend)
SMS_REMINDERS_ENABLED=false
SMS_REMINDER_LOOKBACK_DAYS=90
SMS_AUTO_DAY=1
SMS_AUTO_HOUR=10
SMS_AUTO_MINUTE=0
SMS_REMINDER_MESSAGE=Hi {first_name}, this week's Simple Kitchen menu is live. Order at {shop_url}
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
# Set true only if cutting over after this week's old Woo reminder has already been sent.
SMS_IMPORT_ASSUME_REMINDER_SENT_THIS_WEEK=false
